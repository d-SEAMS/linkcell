prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: linkcell
Description: Periodic linked-cell k-nearest neighbour search
Version: @PROJECT_VERSION@
URL: https://github.com/d-SEAMS/linkcell
Libs: -L${libdir} -llinkcell -llinkcell_eh
Libs.private: @LINKCELL_PKG_LIBS_PRIVATE@
Cflags: -I${includedir}@LINKCELL_EH_PC_CFLAGS@
